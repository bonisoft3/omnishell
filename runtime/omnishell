#!/usr/bin/env sh
# Mise is supplied by Sayt; the stub pins Deno.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/.." && pwd)
# The stub's lock sits beside .mise.toml in ROOT; mise reads it only from a
# trusted config.
export MISE_TRUSTED_CONFIG_PATHS="$ROOT${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
exec "$DIR/deno.toml" run --no-lock --no-check --node-modules-dir=none \
	--config "$ROOT/test/deno.json" \
	--allow-read=".,$ROOT" --allow-write=. --allow-env \
	"$DIR/cli.ts" "$@"
